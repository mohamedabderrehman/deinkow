# Enable Rewrite Engine
RewriteEngine On
RewriteRule ^uploads/projects/ - [F,L]
RewriteRule ^(?:docs|tools)/ - [F,L]
<FilesMatch "\.(sql|env|sqlite|md)$">
Require all denied
</FilesMatch>
RewriteBase /

# Prevent directory listing
Options -Indexes

# Enable Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
    # Compress SVG files
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On
    # Images
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/ico "access plus 1 year"
    # CSS and JavaScript
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    # Fonts
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    # Other
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresByType application/json "access plus 0 seconds"
    # HTML - no cache for SPA
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Cache Control Headers
<IfModule mod_headers.c>
    # Cache static assets
    <FilesMatch "\.(jpg|jpeg|png|gif|svg|ico|woff|woff2|ttf|eot|css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    
    # No cache for HTML
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

# Redirect .html extensions to clean URLs (301 Permanent Redirect)
RewriteCond %{THE_REQUEST} /([^.]+)\.html [NC]
RewriteRule ^ /%1 [NC,L,R=301]

# API routes - don't rewrite, pass through
RewriteCond %{REQUEST_URI} ^/api/
RewriteRule ^ - [L]

# Static files - don't rewrite (CSS, JS, images, fonts, etc.)
RewriteCond %{REQUEST_URI} \.(css|js|jpg|jpeg|png|gif|ico|svg|woff|woff2|ttf|eot|webp|pdf|xml|json)$ [NC]
RewriteRule ^ - [L]

# Uploads directory - allow direct access
RewriteCond %{REQUEST_URI} ^/uploads/
RewriteRule ^ - [L]

# Public pages resolve to actual HTML before the private application fallback.
DirectoryIndex index.html
RewriteRule ^login/?$ signin.html [L,NC]
RewriteRule ^requestproject/?$ request-project.html [L,NC]
RewriteRule ^(?:home|Home)/?$ index.html [L]
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([a-zA-Z0-9_-]+)/?$ $1.html [L]

# Private application routes fall back to app.html
# This enables client-side routing for the SPA
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_URI} !^/uploads/
RewriteRule ^(.*)$ app.html [L]

# Legacy route mappings (for backward compatibility)
# These routes will also work but redirect to app.html which handles routing
RewriteRule ^Home/?$ app.html [L]
RewriteRule ^home/?$ app.html [L]

RewriteRule ^Login/?$ app.html [L]
RewriteRule ^login/?$ app.html [L]

RewriteRule ^Register/?$ app.html [L]
RewriteRule ^register/?$ app.html [L]
RewriteRule ^GetStarted/?$ app.html [L]
RewriteRule ^get-started/?$ app.html [L]

RewriteRule ^Dashboard/?$ app.html [L]
RewriteRule ^dashboard/?$ app.html [L]

RewriteRule ^Pricing/?$ app.html [L]
RewriteRule ^pricing/?$ app.html [L]

RewriteRule ^Profile/?$ app.html [L]
RewriteRule ^profile/?$ app.html [L]

RewriteRule ^Support/?$ app.html [L]
RewriteRule ^support/?$ app.html [L]

RewriteRule ^Templates/?$ app.html [L]
RewriteRule ^templates/?$ app.html [L]

RewriteRule ^RequestProject/?$ app.html [L]
RewriteRule ^request-project/?$ app.html [L]

RewriteRule ^Workroom/?$ app.html [L]
RewriteRule ^workroom/?$ app.html [L]

RewriteRule ^Team/?$ app.html [L]
RewriteRule ^team/?$ app.html [L]

RewriteRule ^CaseStudy/([0-9]+)/?$ app.html [L]
RewriteRule ^casestudy/([0-9]+)/?$ app.html [L]

RewriteRule ^Admin/?$ app.html [L]
RewriteRule ^admin/?$ app.html [L]
RewriteRule ^Admin/Login/?$ app.html [L]
RewriteRule ^admin/login/?$ app.html [L]

# Root redirect to app.html
RewriteRule ^/?$ app.html [L]

# Security Headers
<IfModule mod_headers.c>
    # Basic Security Headers
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    
    # Content Security Policy (relaxed for SPA)
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.google.com https://www.gstatic.com https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; connect-src 'self' https://www.google.com https://www.gstatic.com; frame-src 'self' https://www.google.com https://www.gstatic.com; child-src 'self' https://www.google.com https://www.gstatic.com;"
    
    # Remove server signature
    Header unset Server
    Header unset X-Powered-By
</IfModule>

# Prevent access to sensitive files
<FilesMatch "\.(env|log|sql|md|json|htaccess|htpasswd|ini|sh|bak|backup|old|tmp)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Prevent access to hidden files (except .htaccess)
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Allow .htaccess
<Files ".htaccess">
    Order allow,deny
    Allow from all
</Files>

# PHP Settings (if PHP files exist)
<IfModule mod_php7.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 10M
    php_value max_execution_time 120
    php_value memory_limit 256M
</IfModule>

# Error Pages (optional - customize as needed)
# ErrorDocument 404 /app.html
# ErrorDocument 500 /app.html

# Force HTTPS (uncomment if you have SSL)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Force WWW or non-WWW (uncomment and choose one)
# Force WWW:
# RewriteCond %{HTTP_HOST} !^www\. [NC]
# RewriteRule ^(.*)$ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# Force non-WWW:
# RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
# RewriteRule ^(.*)$ https://%1%{REQUEST_URI} [L,R=301]
